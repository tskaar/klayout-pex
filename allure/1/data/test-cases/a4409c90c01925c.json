 sorted((supporting_files or {}).items()))\n        text += Path(input_file_path).read_text(encoding='utf-8')\n        return pex25d.read_text(text.encode('utf-8'), report=report)\n\ndef create_importer() -> Importer:\n    return Importer()\n'"]}